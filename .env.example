# RealGazebo environment variables
# Copy to .env and customize:  cp .env.example .env

# Display for GUI mode (default: :0)
# DISPLAY=:0

# Headless mode (default: true — no Gazebo GUI)
# HEADLESS=true

# World type: c-track, urban, vils (default: c-track)
# WORLD=c-track

# Unreal Engine server IP (default: host.docker.internal)
# UNREAL_IP=host.docker.internal

# Unreal Engine server port (default: 5005)
# UNREAL_PORT=5005

# Gazebo network partition (default: realgazebo)
# GZ_PARTITION=realgazebo

# MAVLink GCS IP for ground control station (default: 172.17.0.1)
# MAVLINK_GCS_IP=172.17.0.1

# Local user ID for file permissions (default: auto)
# LOCAL_USER_ID=1000

# PX4 firmware path on host (optional, for vehicle containers)
# PX4_PATH=

# GPU acceleration (default: auto-detect)
# USE_GPU=true

# Verbose logging (default: false)
# VERBOSE=false
