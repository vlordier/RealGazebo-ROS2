# Minimal test image: runs Python unit tests inside an isolated container
FROM ghcr.io/astral-sh/uv:latest AS uv
FROM python:3.12-slim

WORKDIR /app

# Install uv from the official image
COPY --from=uv /uv /uvx /bin/

# Install test dependencies via uv (faster, deterministic)
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt --quiet

# Copy only the test files and source code needed
COPY scripts/ scripts/
COPY src/ src/
COPY realgazebo-dora/ realgazebo-dora/
COPY pyproject.toml .

# Default command: run tests with scripts/ on import path
ENV PYTHONPATH=/app/scripts
CMD ["python3", "-m", "pytest", "scripts/tests/", "-v", "-m", "not integration"]
